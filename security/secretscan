#!/data/data/com.termux/files/usr/bin/env python3
"""
secretscan -- find credentials in a source tree, before they are committed.

    secretscan [PATH ...]                 # scan PATHs (default: current dir)
    secretscan --baseline FILE            # ignore known-safe matches by fingerprint
    secretscan --json                     # machine-readable output
    secretscan --allow PATTERN            # suppress a rule (repeatable)
    secretscan --all                      # include SYNTHETIC/PLACEHOLDER rows

WHY THIS EXISTS AND WHY IT IS NOT JUST `grep`

A plain grep for `sk-` would have found the OpenRouter key in agent.json. It
would also have produced a wall of false positives, and -- the part that
actually matters -- it cannot tell a LIVE credential from a TEST FIXTURE. This
repo has both: a real key in agent.json, and four synthetic strings in
daemon.test.mjs built as "sk-or-v1-" + "a".repeat(48). A scanner that cannot
separate those is a scanner people learn to ignore.

So this classifies every match:

    LIVE      a real credential-shaped value, not obviously synthetic
    SYNTHETIC looks constructed in code (repeat/join/concat/template)
    PLACEHOLDER obvious filler: your-key, xxx, <token>, ${VAR}
    EXAMPLE    matches a known public sample key from documentation
    REVIEW     cannot decide -- needs a human

Exit codes: 0 clean, 1 findings at REVIEW or worse, 2 usage error. That makes it
usable as a pre-commit gate, which a scanner that cries wolf never is.

DETECTION NOTES

Entropy is computed per finding, not per file. A long line of prose has high
entropy overall but the *token* may still be a word. Only the candidate is
measured, and only when it is long enough for the estimate to mean anything.

Patterns are deliberately conservative: requiring a length floor and a charset
specific to each provider. An over-broad `sk-[a-zA-Z0-9]{16,}` matches base64
blobs and commit hashes; the per-provider shapes below do not.

The scanner never prints a secret. Findings carry a redacted preview and a
fingerprint (a SHA-256 prefix of rule+value) so a finding can be baselined
without the baseline file itself becoming a secret store.
"""

import argparse
import hashlib
import json
import math
import os
import re
import sys
from collections import Counter

# Files and directories that never contain reviewable source.
SKIP_DIRS = {
    ".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build",
    ".backup", ".sandbox", ".scratch",
}
SKIP_FILES = {
    "package-lock.json", "poetry.lock", "Cargo.lock", "yarn.lock",
}

# The scanner must not flag its own detection patterns. secretscan contains
# literal sample keys (EXAMPLE_VALUES) and example bearer strings purely so the
# classifier can recognise them; scanning itself made it report LIVE on line 113
# of its own source, which is exactly the noise that gets a tool switched off.
# Skipping the whole file is right rather than suppressing rules: nothing else
# lives there.
SELF_FILES = {"secretscan", "secretscan.py"}

# Files where a credential is EXPECTED and tracked separately. They are still
# scanned, but a hit is reported as LIVE with the file named, because a scanner
# that silently skips its own credential store is worse than no scanner.
CREDENTIAL_FILES = {
    "agent.json", "agent.cloud.json", "agent.cloud.backup.json", "agent.json.pre-502",
}

# (rule, compiled pattern, provider label)
RULES = [
    ("openrouter", re.compile(r"\bsk-or-v1-[A-Za-z0-9]{40,}\b"), "OpenRouter"),
    ("anthropic",  re.compile(r"\bsk-ant-[A-Za-z0-9\-_]{32,}\b"), "Anthropic"),
    ("openai",     re.compile(r"\bsk-(?!or-)[A-Za-z0-9]{32,}\b"), "OpenAI"),
    ("hf",         re.compile(r"\bhf_[A-Za-z0-9]{30,}\b"), "HuggingFace"),
    ("github",     re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}\b"), "GitHub token"),
    ("aws",        re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), "AWS access key id"),
    ("google",     re.compile(r"\bAIza[0-9A-Za-z\-_]{35}\b"), "Google API key"),
    ("slack",      re.compile(r"\bxox[baprs]-[0-9A-Za-z\-]{10,}\b"), "Slack token"),
    ("stripe",     re.compile(r"\b[sr]k_live_[0-9A-Za-z]{20,}\b"), "Stripe live key"),
    ("jwt",        re.compile(r"\beyJ[A-Za-z0-9\-_]{10,}\.eyJ[A-Za-z0-9\-_]{10,}\.[A-Za-z0-9\-_]{10,}\b"), "JWT"),
    ("private_key", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----"), "Private key block"),
    ("bearer",     re.compile(r"(?i)\bauthorization\s*[:=]\s*['\"]?Bearer\s+([A-Za-z0-9\-._~+/]{20,}=*)"), "Bearer token"),
]

# Public sample keys used in vendor docs. Seeing these is a documentation bug,
# not a leak, and flagging them trains people to ignore the tool.
EXAMPLE_VALUES = {
    "sk-or-v1-0000000000000000000000000000000000000000000000000",
}

# Filler that means "put something here".
PLACEHOLDER_HINTS = (
    "your", "example", "placeholder", "changeme", "change-me", "xxxx",
    "todo", "fixme", "dummy", "fake", "sample", "insert", "replace",
    "<token", "${", "{{", "redacted", "notreal",
)

# If the surrounding source line builds the value, it is a fixture.
SYNTHETIC_HINTS = (
    "repeat(", '" + "', "' + '", "join(", 'f"', "format(", "b\"", "%s",
    "string.", "Buffer.alloc", "\\x00", "AAAA",
)

# Test files are where credential-shaped strings legitimately live. This is not
# a blanket exemption: a real key accidentally pasted into a test is exactly the
# case that matters, so hits in a test file are still reported -- but as REVIEW
# with the path named, not LIVE. The distinction is "is this file asserting
# about credentials" rather than "is this file a test".
#
# Added after a false positive: daemon.test.mjs contains a literal
# "Authorization: Bearer abcdefghijklmnopqrstuvwx" used to prove redaction works.
# It is not built with repeat(), so the line heuristic missed it and it scored
# LIVE on entropy alone -- which is precisely the cry-wolf behaviour that gets a
# real scanner switched off.
TEST_PATH_HINTS = (
    "/test", "test.", ".test.", "_test.", "/spec", "spec.", "fixture",
)

# Words that mark a literal as deliberate sample data even in a non-test file.
#
# Matched as SUBSTRINGS OF A RUN, not bare substrings. The first version used a
# plain `in` test and that was a false-negative generator: "RealLooking" contains
# "real" (not a sample word, fine) but "AbCdEfGhIjKlMnOpQrStUvWxYz" contains
# "abcdef" case-insensitively, so two plausible real-looking keys were classified
# SYNTHETIC and would have been skipped. A sample marker only counts when it is
# the WHOLE token -- real keys are not written in dictionary words.
SAMPLE_WORDS = ("abc123", "abcdef", "0123456789", "deadbeef", "qwerty",
                "aaaaaaa", "foobar", "samplekey", "testkey", "notreal",
                "fakekey", "dummykey", "changeme", "letmein", "p@ssw0rd")

TEXT_EXT = {
    ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".py", ".sh", ".bash", ".json",
    ".md", ".txt", ".yml", ".yaml", ".toml", ".ini", ".cfg", ".env", ".xml",
    ".html", ".css", ".sql", ".go", ".rb", ".rs", ".java", ".c", ".h", ".cpp",
    ".php", ".ps1", ".bat", "", ".conf", ".pem", ".key", ".secret",
}


def shannon_entropy(s):
    """Bits per character. Random base64 ~ 5.5-6.0; English prose ~ 3.5-4.0."""
    if not s:
        return 0.0
    counts = Counter(s)
    n = len(s)
    return -sum((c / n) * math.log2(c / n) for c in counts.values())


def read_text(path, max_bytes=4_000_000):
    try:
        if os.path.getsize(path) > max_bytes:
            return None
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except (OSError, UnicodeError):
        return None


def classify(rule, value, line, filename):
    """Return (verdict, reason). Verdicts: LIVE, REVIEW, SYNTHETIC, PLACEHOLDER, EXAMPLE."""
    low_value = value.lower()
    low_path = filename.replace("\\", "/").lower()
    base = os.path.basename(filename)

    if any(v in value for v in EXAMPLE_VALUES):
        return "EXAMPLE", "matches a published documentation sample value"

    if any(h in low_value for h in PLACEHOLDER_HINTS):
        return "PLACEHOLDER", "value contains filler markers"

    # Sample data spelled out in plain letters: "abcdefghij", "0123456789", ...
    # Whole-token match only. Checked before entropy, because entropy cannot
    # tell a spelled-out sample from a random key of similar length.
    stripped = value.strip().strip("\"'`")
    if stripped.lower() in SAMPLE_WORDS:
        return "SYNTHETIC", "value is exactly a known sample string"
    # A long run of a single repeated character is filler, not a key.
    if len(set(stripped.lower())) <= 3 and len(stripped) >= 12:
        return "SYNTHETIC", "value is a repeated-character run"

    # A secret assembled in code is a test fixture. Check the LINE, because the
    # fixture is defined by how the value is produced, not by its shape.
    if any(h in line for h in SYNTHETIC_HINTS):
        return "SYNTHETIC", "value is constructed in source (repeat/concat/f-string)"

    # A credential in a file that is itself a credential store. Still LIVE, and
    # named, because that is the exact finding that mattered on 2026-10-01.
    if base in CREDENTIAL_FILES:
        return "LIVE", f"live credential in {base}, which sits inside the repository tree"

    if rule == "private_key":
        return "LIVE", "private key material"

    ent = shannon_entropy(value)

    # A credential-shaped literal inside a test file: probably sample data, but
    # a pasted real key would look identical. REVIEW is the honest verdict, and
    # the file is named so a human can look in one step.
    if any(h in low_path for h in TEST_PATH_HINTS):
        return "REVIEW", (
            f"credential-shaped literal in a test file (entropy {ent:.2f}); "
            "sample data is expected here, but a real key would look the same"
        )

    # ENTROPY BANDS, per charset. The first version used one threshold (4.2)
    # and it was calibrated on nothing. Measured against the actual OpenRouter
    # key from agent.json, it scored 4.14 and was demoted to REVIEW -- a real,
    # live credential nearly missed by a number I guessed.
    #
    # Why the bands differ: Shannon entropy is bounded by log2(charset).
    #   hex  [0-9a-f]      16 symbols -> max 4.00 bits/char, real keys ~3.9-4.0
    #   base62             62 symbols -> max 5.95 bits/char, real keys ~5.5-5.9
    # A single threshold is therefore wrong for one of the two families. For hex
    # the only meaningful discriminator is the character-set CHECK itself, so
    # hex keys are LIVE once they pass the structural rules above.
    charset_size = len(set(value.lower()))
    is_hex = all(c in "0123456789abcdef" for c in value.lower())
    looks_random = is_hex or charset_size >= 20 or ent >= 3.8

    if len(value) >= 24 and ent < 2.6:
        return "PLACEHOLDER", f"very low entropy ({ent:.2f}) suggests filler"

    if len(value) >= 24 and looks_random:
        return "LIVE", (
            f"provider-shaped and not constructed ({'hex' if is_hex else f'{charset_size}-symbol'}, "
            f"entropy {ent:.2f})"
        )

    # In between: could be either. Do not guess.
    return "REVIEW", f"ambiguous (entropy {ent:.2f}, {charset_size} distinct chars, length {len(value)})"


def fingerprint(rule, value):
    """Stable id for a finding. Derived from the secret, so never reversible to it."""
    h = hashlib.sha256((rule + "|" + value).encode()).hexdigest()[:16]
    return f"{rule}:{h}"


def iter_files(paths):
    for root_path in paths:
        if os.path.isfile(root_path):
            yield root_path
            continue
        for dirpath, dirnames, filenames in os.walk(root_path):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".git")]
            for name in filenames:
                if os.path.splitext(name)[1].lower() not in TEXT_EXT:
                    continue
                if name in SKIP_FILES or name in SELF_FILES:
                    continue
                yield os.path.join(dirpath, name)


def scan(paths, allow=None, baseline=None):
    allow = [re.compile(p) for p in (allow or [])]
    baseline = set(baseline or [])
    findings = []
    files_scanned = 0
    lines_scanned = 0

    for path in iter_files(paths):
        text = read_text(path)
        if text is None:
            continue
        files_scanned += 1

        for lineno, line in enumerate(text.splitlines(), start=1):
            if len(line) > 4000:
                continue
            lines_scanned += 1

            for rule, pattern, provider in RULES:
                for match in pattern.finditer(line):
                    value = match.group(match.lastindex or 0) if match.groups() else match.group(0)
                    if any(a.search(value) for a in allow):
                        continue
                    fp = fingerprint(rule, value)
                    if fp in baseline:
                        continue
                    verdict, reason = classify(rule, value, line, path)
                    findings.append({
                        "file": path,
                        "line": lineno,
                        "rule": rule,
                        "provider": provider,
                        "verdict": verdict,
                        "reason": reason,
                        "fingerprint": fp,
                        # Redacted preview: enough to locate, not enough to use.
                        "preview": (value[:6] + "..." + value[-4:]) if len(value) > 12 else "...",
                    })
    return findings, files_scanned, lines_scanned


SEVERITY = {"LIVE": 3, "REVIEW": 2, "EXAMPLE": 0, "SYNTHETIC": 0, "PLACEHOLDER": 0}
COLORS = {"LIVE": "\033[31m", "REVIEW": "\033[33m", "SYNTHETIC": "\033[90m",
          "PLACEHOLDER": "\033[90m", "EXAMPLE": "\033[90m", "OFF": "\033[0m"}


def main():
    ap = argparse.ArgumentParser(description="Find credentials in a source tree.")
    ap.add_argument("paths", nargs="*", default=["."])
    ap.add_argument("--baseline", help="file of fingerprints to ignore")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--allow", action="append", default=[])
    ap.add_argument("--all", action="store_true", help="include SYNTHETIC/PLACEHOLDER rows")
    args = ap.parse_args()

    baseline = []
    if args.baseline and os.path.exists(args.baseline):
        with open(args.baseline) as fh:
            baseline = [l.strip() for l in fh if l.strip() and not l.startswith("#")]

    findings, files, lines = scan(args.paths, args.allow, baseline)

    if args.json:
        print(json.dumps({"filesScanned": files, "linesScanned": lines, "findings": findings}, indent=2))
    else:
        colors = COLORS if sys.stdout.isatty() else {k: "" for k in COLORS}
        print(f"scanned {files} files, {lines} lines")
        actionable = [f for f in findings if args.all or SEVERITY[f["verdict"]] > 0]
        actionable.sort(key=lambda f: (-SEVERITY[f["verdict"]], f["file"], f["line"]))
        for f in actionable:
            c = colors.get(f["verdict"], "")
            print(f"{c}{f['verdict']:<11}{colors['OFF']} {f['provider']:<18} "
                  f"{f['file']}:{f['line']}  {f['preview']}")
            print(f"{'':11} {f['reason']}")
            print(f"{'':11} fingerprint {f['fingerprint']}")
        counts = Counter(f["verdict"] for f in findings)
        if counts:
            print("\n" + ", ".join(f"{k}={v}" for k, v in sorted(counts.items())))
        if not actionable:
            print("no actionable findings")

    worst = max((SEVERITY[f["verdict"]] for f in findings), default=0)
    return 1 if worst >= 2 else 0


if __name__ == "__main__":
    sys.exit(main())